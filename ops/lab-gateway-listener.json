[
  {
    "op": "add",
    "path": "/spec/listeners/-",
    "value": {
      "name": "lab-https",
      "hostname": "lab.mahendrarendi.cloud",
      "port": 443,
      "protocol": "HTTPS",
      "tls": {
        "mode": "Terminate",
        "certificateRefs": [
          {
            "kind": "Secret",
            "name": "lab-tls"
          }
        ]
      },
      "allowedRoutes": {
        "namespaces": {
          "from": "Selector",
          "selector": {
            "matchLabels": {
              "kubernetes.io/metadata.name": "labk8stack"
            }
          }
        }
      }
    }
  }
]
